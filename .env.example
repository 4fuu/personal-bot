# personal-bot configuration.
#
# Copy this file to `.env` next to `compose.yaml` and fill it in. Every value is
# required unless it says otherwise.
#
# Docker Compose reads `.env` as a plain env file, so this file is one too:
# KEY=value lines and `#` comments, nothing else. Do not turn it into a
# document, and do not add a fence, a heading or a prose line - compose refuses
# to start on anything that is not a variable or a comment.

# The console's password. This is the only thing standing between the internet
# and your panel, so make it long.
CONSOLE_PASSWORD=change-me

# The three internal tokens. Generate them with:
#   openssl rand -hex 32
DRIVER_TOKEN=
BOT_TOKEN=
SANDBOX_EXEC_TOKEN=

# The tokens never leave the stack: the driver refuses to start without
# DRIVER_TOKEN, the console holds BOT_TOKEN and never hands it to the browser,
# and the sandbox's exec token arrives in its environment, which only root
# inside that container can read.

# --- QQ: exactly one of these two, see README.md "First start" ---------------
# A URL the qq container downloads the pinned build from. Comment this out to
# install from a mounted file instead.
QQ_DEB_URL=

# --- optional ---------------------------------------------------------------
# 1 disables pi's model-catalog fetch, for fully offline runs.
PI_OFFLINE=0

# How long the first boot waits for the database-key extraction before it stops
# waiting for it. The runner measured the extraction at up to about 8 minutes
# under the virtual display, which is what the default (900) allows for; raise
# it on a slow machine. The driver keeps watching afterwards, so a timeout is
# not fatal: the database key status in the console turns to 正常 once the key
# lands.
KEYX_TIMEOUT_S=900

# The image tag to run. Leave it empty for `latest` (the newest release), or
# pin one, for example v2026.1025.0.
PERSONAL_BOT_TAG=
